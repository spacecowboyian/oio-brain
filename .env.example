# OIO Racing Slackbot Environment Variables

# Slack Bot Token (xoxb-...)
# Get from: https://api.slack.com/apps > Your App > Install App > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-token-here

# Slack App Token (xapp-...)
# Get from: https://api.slack.com/apps > Your App > App-Level Tokens > Generate Token > socket.connect:write events:read
SLACK_APP_TOKEN=xapp-your-token-here

# PostBridge API Key for publishing to Instagram/Facebook
# Get from: PostBridge dashboard
POSTBRIDGE_API_KEY=your-postbridge-key-here

# Anthropic API Key for Claude API calls
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Caption Generation Service URL (default: http://localhost:5000)
# Set if running caption service on different host
# CAPTION_SERVICE_URL=http://localhost:5000

# Slack Channel ID for notifications (C...)
# Get from: Right-click channel > Copy Link > Extract channel ID
SLACK_CHANNEL_ID=C123456789

# Slack Bot Token for notifications (same as SLACK_BOT_TOKEN)
SLACK_BOT_TOKEN_NOTIFY=xoxb-your-token-here
